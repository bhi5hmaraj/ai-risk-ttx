{
  "name": "ai-risk-ttx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:analyze": "ANALYZE=true next build",
    "dev:mock": "node scripts/dev.mjs --mock-llm",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "hooks:install": "sh -c 'command -v git >/dev/null 2>&1 || exit 0; git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0; git config extensions.worktreeConfig true && git config --worktree core.hooksPath .githooks'",
    "prepare": "sh -c 'if [ -z \"$CI\" ]; then npm run hooks:install; else echo \"[prepare] CI detected, skipping hooks install\"; fi'",
    "postinstall": "prisma generate",
    "db:setup": "chmod +x scripts/setup-local-db.sh && scripts/setup-local-db.sh",
    "db:studio": "npx prisma studio",
    "db:studio:dev": "node scripts/prisma-studio-dev.mjs",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:dev": "node scripts/prisma-migrate-dev.mjs",
    "db:reset": "npx prisma migrate reset",
    "analyze": "tsx scripts/analyze-feedback.ts",
    "scenarios": "tsx scripts/manage-scenarios.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "node scripts/vitest-runner.mjs",
    "test:watch": "vitest --watch",
    "test:redis": "node scripts/test-redis.mjs",
    "type-check": "tsc --noEmit",
    "coverage:readme": "node scripts/update-coverage-readme.mjs",
    "metrics": "npm run test:coverage && npm run type-check && npm run coverage:readme"
  },
  "dependencies": {
    "@vercel/analytics": "^1.3.1",
    "@clerk/nextjs": "^6.35.1",
    "@prisma/client": "^6.17.1",
    "@upstash/redis": "^1.35.6",
    "autoprefixer": "^10.4.21",
    "cytoscape": "3.29.2",
    "hono": "^4.10.3",
    "next": "^15.5.6",
    "openai": "^4.76.0",
    "react": "^19.1.0",
    "react-cytoscapejs": "2.0.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.65.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.7",
    "zod": "^3.25.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.33",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.9",
    "@types/react-cytoscapejs": "^1.2.5",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/ui": "^4.0.3",
    "cytoscape-dagre": "^2.5.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.1.6",
    "jsdom": "^24.1.0",
    "postcss": "^8",
    "prisma": "^6.17.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "~5.7.2",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
