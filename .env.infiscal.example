# Infisical (Machine Identity / Universal Auth) — recommended
# NOTE: copy to `.env.infiscal` (ignored by git) and fill values.

# Optional (defaults to https://app.infisical.com)
INFISICAL_SITE_URL=

# Environment slug (examples: dev, stg, prod — or your custom slug)
INFISICAL_ENVIRONMENT=dev

# Infisical project id (UUID)
# (Infisical API uses workspaceId internally; SDK expects projectId)
INFISICAL_PROJECT_ID=

# Machine identity credentials (Universal Auth)
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# --- Alternative auth (Service Token) ---
# If you prefer service tokens, set this instead of the Universal Auth fields above.
# INFISICAL_TOKEN=st....

# --- Local overrides (optional) ---
# When set, local env wins over Infisical (our loader never overrides existing process.env keys).
DATABASE_URL=
