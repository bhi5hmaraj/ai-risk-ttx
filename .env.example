# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/ai-risk-ttx?schema=public"

# LLM Configuration (Server-side - API Routes)
LITELLM_API_KEY="your-litellm-api-key-here"
LITELLM_BASE_URL="https://asgard.bhishmaraj.org"
LLM_MODEL="gpt-4o-mini"

# Legacy Client-side LLM Configuration (DEPRECATED - will be removed)
# These are being migrated to server-side API routes for security
# VITE_LITELLM_API_KEY="your-api-key"  # DO NOT USE - Exposes key to client
# VITE_LLM_MODEL="gpt-4o-mini"         # DO NOT USE - Migrate to LLM_MODEL

# Admin / Auth - Clerk (https://clerk.com)
# Get your keys from: https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Admin Access Control
# Comma-separated list of emails that can access the admin panel
ADMIN_EMAILS="your-email@example.com,admin2@example.com"

# Legacy admin auth (deprecated - replaced by Clerk)
# ADMIN_PASSWORD_1="set-a-strong-password"

# -----------------------------
# Colyseus (WebSocket Server)
# -----------------------------
# For dev: set a dedicated port for Colyseus. The dev runner will inject this into PORT.
# Example: 3004
COLYSEUS_PORT=

# For the browser: the full WS(S) URL to connect to.
# REQUIRED for both dev and prod to avoid hardcoded defaults.
# Examples:
#   ws://localhost:3004
#   wss://your-domain.example
NEXT_PUBLIC_COLYSEUS_URL=

# Optional: Next.js dev server port (UI). If unset, Next uses its default.
NEXT_DEV_PORT=

# Test helpers
# Used by scripts/test-colyseus.ts and scripts/test-loading-states.ts
TEST_COLYSEUS_URL=
