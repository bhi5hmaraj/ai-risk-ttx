{
  "name": "ai-risk-ttx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:monolith": "node scripts/dev-monolith.mjs",
    "build:analyze": "ANALYZE=true next build",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "dev:mock": "node scripts/dev.mjs --mock-llm",
    "build": "next build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "hooks:install": "sh -c 'command -v git >/dev/null 2>&1 || exit 0; git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0; git config extensions.worktreeConfig true && git config --worktree core.hooksPath .githooks'",
    "prepare": "sh -c 'if [ -z \"$CI\" ]; then pnpm run hooks:install; else echo \"[prepare] CI detected, skipping hooks install\"; fi'",
    "postinstall": "sh -c 'command -v prisma >/dev/null 2>&1 && prisma generate || echo \"[postinstall] Skipping prisma generate\"'",
    "db:setup": "chmod +x scripts/setup-local-db.sh && scripts/setup-local-db.sh",
    "db:studio": "npx prisma studio",
    "db:studio:dev": "node scripts/prisma-studio-dev.mjs",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:dev": "node scripts/prisma-migrate-dev.mjs",
    "db:reset": "npx prisma migrate reset",
    "analyze": "tsx scripts/analyze-feedback.ts",
    "scenarios": "tsx scripts/manage-scenarios.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "node scripts/vitest-runner.mjs",
    "test:watch": "vitest --watch",
    "test:redis": "node scripts/test-redis.mjs",
    "type-check": "tsc --noEmit",
    "coverage:readme": "node scripts/update-coverage-readme.mjs",
    "metrics": "pnpm run test:coverage && pnpm run type-check && pnpm run coverage:readme",
    "logs:view": "node scripts/view-logs.mjs",
    "logs:follow": "node scripts/view-logs.mjs --follow"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.41",
    "@clerk/nextjs": "^6.35.1",
    "@colyseus/monitor": "^0.16.7",
    "@colyseus/schema": "^3.0.69",
    "@colyseus/ws-transport": "^0.16.5",
    "@copilotkit/react-core": "^1.10.6",
    "@copilotkit/react-ui": "^1.10.6",
    "@copilotkit/runtime": "^1.10.6",
    "@copilotkit/shared": "^1.10.6",
    "@infisical/sdk": "^4.0.6",
    "@prisma/client": "^6.17.1",
    "@sentry/node": "^10.27.0",
    "@upstash/redis": "^1.35.6",
    "@vercel/analytics": "^1.3.1",
    "autoprefixer": "^10.4.21",
    "colyseus": "^0.16.5",
    "cors": "^2.8.5",
    "cytoscape": "3.29.2",
    "eslint-plugin-boundaries": "^5.3.0",
    "express": "^5.1.0",
    "hono": "^4.10.3",
    "next": "^15.5.6",
    "openai": "^4.76.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "react": "^19.1.0",
    "react-cytoscapejs": "2.0.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.65.0",
    "react-qr-code": "^2.0.18",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.7",
    "zod": "^3.25.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.33",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.9",
    "@types/react-cytoscapejs": "^1.2.5",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/ui": "^4.0.3",
    "colyseus.js": "^0.16.22",
    "cytoscape-dagre": "^2.5.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.1.6",
    "istanbul-lib-coverage": "^3.2.0",
    "jsdom": "^24.1.0",
    "postcss": "^8",
    "prisma": "^6.17.1",
    "tailwindcss": "^3.4.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "~5.7.2",
    "vite": "^5.4.10",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.21.0"
}