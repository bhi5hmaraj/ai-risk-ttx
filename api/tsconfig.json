{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "./**/*",
    "../server/routes/**/*",
    "../server/services/**/*",
    "../server/lib/logger.ts",
    "../server/types/**/*",
    "../types/**/*",
    "../prompts.ts",
    "../gameConfig.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../.vercel"
  ]
}
