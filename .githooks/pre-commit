#!/usr/bin/env bash
set -euo pipefail

# Ensure we run from repo root
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Allow bypass via env var
if [ "${SKIP_PRECOMMIT_TESTS:-}" = "1" ]; then
  echo "[pre-commit] SKIP_PRECOMMIT_TESTS=1 → skipping tests"
  exit 0
fi

# Determine if staged changes include code paths
CHANGED_FILES="$(git diff --cached --name-only --diff-filter=ACM || true)"
if [ -z "$CHANGED_FILES" ]; then
  echo "[pre-commit] No staged changes; skipping."
  exit 0
fi

NEED_TEST=0
for f in $CHANGED_FILES; do
  case "$f" in
    *.ts|*.tsx|*.js|*.jsx|*.json|package.json|next.config.*|app/*|lib/*|server/*)
      NEED_TEST=1
      break
      ;;
  esac
done

if [ "$NEED_TEST" = "0" ]; then
  echo "[pre-commit] No relevant code changes; skipping tests."
  exit 0
fi

echo "[pre-commit] Running type-check…"
npm run -s type-check

echo "[pre-commit] Running unit tests with coverage…"
npm run -s test:coverage

echo "[pre-commit] Updating README coverage…"
if npm run -s coverage:readme; then
  # Stage README if it changed so coverage table lands in this commit
  if ! git diff --quiet -- README.md 2>/dev/null; then
    git add README.md
    echo "[pre-commit] Staged README.md with refreshed coverage"
  fi
else
  echo "[pre-commit] Warning: coverage:readme failed; continuing"
fi

echo "[pre-commit] OK"
